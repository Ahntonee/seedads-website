# ============================================================
#  SeedsAds Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ---- Server -------------------------------------------------
PORT=3002

# ---- PostgreSQL Database (REQUIRED) -------------------------
# Get a free connection string from https://neon.tech
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ---- Security (REQUIRED — app refuses to start without JWT_SECRET) ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string

# ---- Admin account ------------------------------------------
# Only used on FIRST run to set the admin password.
# Leave blank to auto-generate (random password printed to console once).
ADMIN_PASSWORD=

# ---- Cloudinary (for production image uploads) --------------
# Get these from https://console.cloudinary.com → Dashboard
# If left blank, images upload to local disk (dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email / SMTP (optional — app works without it) ---------
# Using Gmail: enable 2-Step Verification, then create an App Password
ADMIN_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ---- Site URL (used in email links and CORS) ----------------
# Must match your actual domain (no trailing slash)
SITE_URL=https://yourdomain.onrender.com
