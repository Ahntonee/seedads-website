# ============================================================
#  SeedsAds Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ---- Server -------------------------------------------------
PORT=3002

# ---- PostgreSQL Database (REQUIRED) -------------------------
# Get a free connection string from https://neon.tech
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ---- Security (REQUIRED — app refuses to start without JWT_SECRET) ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string

# ---- Admin account ------------------------------------------
# Only used on FIRST run to set the admin password.
# Leave blank to auto-generate (random password printed to console once).
ADMIN_PASSWORD=

# ---- Cloudinary (REQUIRED in production) --------------------
# Get these from https://console.cloudinary.com → Dashboard
# Stores images, payment receipts, and DMI files persistently.
# If left blank, files save to local disk (DEV ONLY — wiped on every Render deploy).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment Gateways (Shop) --------------------------------
# Paystack: https://dashboard.paystack.com/#/settings/developers
# Set the webhook URL there to: https://yourdomain/api/shop/webhook/paystack
PAYSTACK_SECRET_KEY=
# Stripe: https://dashboard.stripe.com/apikeys
# Set a webhook (checkout.session.completed) to: https://yourdomain/api/shop/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Donations (Flutterwave) --------------------------------
# Flutterwave: https://app.flutterwave.com/dashboard/settings/apis
# PUBLIC key (FLWPUBK-...) is used in the frontend donate popup.
# SECRET key verifies donations server-side. WEBHOOK_HASH = the "Secret hash"
# you set under Settings → Webhooks; point the webhook to:
#   https://yourdomain/api/donations/webhook/flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Email / SMTP (optional — app works without it) ---------
# Using Gmail: enable 2-Step Verification, then create an App Password
ADMIN_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ---- Site URL (used in email links and CORS) ----------------
# Must match your actual domain (no trailing slash)
SITE_URL=https://yourdomain.onrender.com
